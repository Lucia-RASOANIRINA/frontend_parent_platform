# Configuration du frontend Parentia
# Copier ce fichier en « .env » pour surcharger les valeurs par défaut.

# Mode de connexion à l'API : auto | local | online
#   auto   → teste le backend local, bascule sur le backend en ligne s'il est absent
#   local  → force http://localhost:8082
#   online → force https://parentia.onrender.com
VITE_API_MODE=auto

# Adresses des deux backends
VITE_API_LOCAL=http://localhost:8082
VITE_API_ONLINE=https://parentia.onrender.com

# Adresse publique du site (liens de partage des évènements)
VITE_SITE_URL=https://parentia-ten.vercel.app
